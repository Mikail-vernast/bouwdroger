// Proefomgeving: een aparte Worker op workers.dev met Stripe-TESTsleutels, om de
// simulator en een boeking end-to-end te testen vóór iets live gaat.
//
//   npm run build && printf 'User-agent: *\nDisallow: /\n' > dist/robots.txt \
//     && npx wrangler deploy -c wrangler.test.jsonc
//
// (robots.txt: de proef is een kopie van de site op een publiek adres en mag
// niet geïndexeerd worden.)
//
// Verschilt van wrangler.jsonc op vier punten: andere naam (raakt de live Worker
// niet), workers_dev aan, geen crons (die sturen herinneringsmails), en geen
// live-sleutel in vars. Secrets (zet je met `wrangler secret put -c ...`):
// STRIPE_SECRET_KEY en STRIPE_PUBLISHABLE_KEY (test), VERNAST_WEBHOOK_URL, en
// VERNAST_WEBHOOK_SECRET = het testsecret (BOUWDROGER_WEBHOOK_SECRET_LOCAL in
// Supabase). guardKeyMode weigert een live-sleutel op workers.dev sowieso.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bouwdroger-test",
  "main": "worker/index.ts",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/*/", "/*.html", "/404"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "observability": { "enabled": true },
  "vars": {
    "DEPLOY_ENV": "preview",
    "CRON_OWNER": "niemand",
    "VITE_SITE_URL": "https://bouwdroger-test.4z275ghwrv.workers.dev"
  }
}
