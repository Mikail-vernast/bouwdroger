{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "cleanUrls": true,
  "regions": [
    "fra1"
  ],
  "redirects": [
    { "source": "/pages/contact", "destination": "/contact", "permanent": true },
    { "source": "/pages/klantenservice", "destination": "/contact", "permanent": true },
    { "source": "/pages/over-ons", "destination": "/over-ons", "permanent": true },
    { "source": "/pages/over-ons-1", "destination": "/over-ons", "permanent": true },
    { "source": "/pages/algemene-voorwaarden", "destination": "/contact", "permanent": true },
    { "source": "/pages/leveringskosten", "destination": "/levering", "permanent": true },
    { "source": "/pages/werkwijze-pakketten", "destination": "/levering", "permanent": true },
    { "source": "/pages/welke-bouwdroger-heb-ik-nodig", "destination": "/calculator", "permanent": true },
    { "source": "/pages/bouwdroging-op-maat", "destination": "/calculator", "permanent": true },
    { "source": "/pages/belang-van-de-ontvochtigingscapaciteit-van-de-bouwdroger", "destination": "/calculator", "permanent": true },
    { "source": "/pages/moet-ik-een-ventilator-plaatsen", "destination": "/calculator", "permanent": true },
    { "source": "/pages/faq-waterschade", "destination": "/waterschade", "permanent": true },
    { "source": "/pages/in-welke-fase-zet-je-een-bouwdroger-best-in", "destination": "/nieuwbouw", "permanent": true },
    { "source": "/pages/wat-is-de-ideale-temperatuur-om-te-drogen", "destination": "/nieuwbouw", "permanent": true },
    { "source": "/pages/hoe-kan-ik-het-droogproces-nog-versnellen", "destination": "/nieuwbouw", "permanent": true },
    { "source": "/pages/moet-mijn-woning-wind-en-luchtdicht-zijn-tijdens-de-bouwdroging", "destination": "/nieuwbouw", "permanent": true },
    { "source": "/pages/wanneer-is-een-bouwdroger-relevant", "destination": "/", "permanent": true },
    { "source": "/pages/welke-voordeel-biedt-een-bouwdroger-aan", "destination": "/", "permanent": true },
    { "source": "/pages/betaling-succesvol", "destination": "/", "permanent": true },
    { "source": "/pages/technische-details-:slug*", "destination": "/machines", "permanent": true },
    { "source": "/pages/copy-of-technische-details-:slug*", "destination": "/machines", "permanent": true },
    { "source": "/pages/kopie-van-td-:slug*", "destination": "/machines", "permanent": true },
    { "source": "/pages/td-:slug*", "destination": "/machines", "permanent": true },
    { "source": "/pages/eco-:slug*", "destination": "/machines", "permanent": true },
    { "source": "/pages/:slug*", "destination": "/", "permanent": true },

    { "source": "/collections/frontpage", "destination": "/", "permanent": true },
    { "source": "/collections/waarom-bouwdrogen", "destination": "/", "permanent": true },
    { "source": "/collections/bouwdrogers", "destination": "/machines", "permanent": true },
    { "source": "/collections/ventilatoren", "destination": "/machines", "permanent": true },
    { "source": "/collections/verwarming", "destination": "/machines", "permanent": true },
    { "source": "/collections/toebehoren", "destination": "/machines", "permanent": true },
    { "source": "/collections/gebouw-:slug*", "destination": "/calculator", "permanent": true },
    { "source": "/collections/dienst-op-maat", "destination": "/calculator", "permanent": true },
    { "source": "/collections/chape-drogen", "destination": "/nieuwbouw", "permanent": true },
    { "source": "/collections/anhydrietchape-drogen", "destination": "/nieuwbouw", "permanent": true },
    { "source": "/collections/bezetting-drogen", "destination": "/nieuwbouw", "permanent": true },
    { "source": "/collections/vloeren-drogen", "destination": "/nieuwbouw", "permanent": true },
    { "source": "/collections/wanden-drogen", "destination": "/nieuwbouw", "permanent": true },
    { "source": "/collections/zolders-drogen", "destination": "/nieuwbouw", "permanent": true },
    { "source": "/collections/kelder-drogen", "destination": "/renovatie", "permanent": true },
    { "source": "/collections/:slug*", "destination": "/machines", "permanent": true },

    { "source": "/products/:slug*", "destination": "/machines", "permanent": true },
    { "source": "/blogs/:slug*", "destination": "/realisaties", "permanent": true },

    { "source": "/cart", "destination": "/", "permanent": false },
    { "source": "/cart/:slug*", "destination": "/", "permanent": false },
    { "source": "/checkouts/:slug*", "destination": "/", "permanent": false },
    { "source": "/account/:slug*", "destination": "/", "permanent": false },
    { "source": "/search", "destination": "/machines", "permanent": false },
    { "source": "/policies/:slug*", "destination": "/contact", "permanent": true },
    { "source": "/apps/:slug*", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-site"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://*.js.stripe.com https://maps.googleapis.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://*.stripe.com https://*.supabase.co; connect-src 'self' https://api.stripe.com https://maps.googleapis.com https://*.js.stripe.com https://js.stripe.com; frame-src https://www.google.com https://js.stripe.com https://*.js.stripe.com https://hooks.stripe.com https://pay.google.com; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|gif|webp|avif|svg|ico|woff|woff2|ttf|otf|eot)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|mjs|map)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_vercel/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/reconcile-orders",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/reminders",
      "schedule": "0 13 * * *"
    }
  ]
}
